# Porta do servidor (padrão: 3000)
PORT=3000

# Senha compartilhada para o login (opcional).
# Se definida, o campo de senha aparece na tela de login e todos os usuários
# precisam informá-la para entrar. Deixe em branco para desativar.
APP_SECRET=

# Origem permitida para requisições CORS (opcional).
# Em produção, coloque a URL do servidor (ex: http://192.168.1.10:3000).
# Deixe em branco para aceitar qualquer origem (padrão de desenvolvimento).
CORS_ORIGIN=
